# Copy to .env and fill in the keys. .env is never committed.
# Every setting below except the API keys already defaults to the value shown,
# so a local run needs only the keys (and not even those until step 11).

# Server
HTTP_ADDR=:8080
LOG_LEVEL=info
# Session cookies are HTTPS-only unless this is "false". `make dev` sets it to
# false for you, because the local stack serves plain HTTP.
COOKIE_SECURE=false
# Share links are derived from this secret (at least 32 characters). Required:
# the server will not start without it. `make dev` creates one for you in
# .data/share-link-secret; elsewhere generate one with `openssl rand -hex 32`.
SHARE_LINK_SECRET=
# Where the web pages are served; share links start with this, and it is the
# only other origin allowed to open the WebSocket. Write it exactly as the
# browser shows it.
PUBLIC_BASE_URL=http://localhost:3000
# Where uploaded portraits and recordings are kept locally.
OBJECT_STORE_DIR=.data/objects
# The two fixed ElevenLabs voices, recorded on each room when it is created.
VOICE_ID_A=
VOICE_ID_B=

# On AWS only; leave these unset locally (README, "Deploying to AWS").
# DSQL_ENDPOINT replaces DATABASE_URL, S3_BUCKET replaces OBJECT_STORE_DIR,
# and TEMPORAL_API_KEY turns on TLS and API-key sign-in for Temporal Cloud.
# DSQL_ENDPOINT=
# DSQL_USER=admin
# S3_BUCKET=
# TEMPORAL_API_KEY=

# Local infrastructure (docker-compose.yml and the Temporal dev server)
DATABASE_URL=postgres://monster:monster@localhost:5432/monstertheatre?sslmode=disable
REDIS_URL=redis://localhost:6379/0
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=performance

# The performance (read by the worker)
VOTE_WINDOW=10s
PREMIERE_COUNTDOWN=5s
# "fake" gives scripted lines and silent recordings and spends nothing.
# For the real ones: LLM_PROVIDER=anthropic and TTS_PROVIDER=elevenlabs.
LLM_PROVIDER=fake
TTS_PROVIDER=fake
# The models the real providers use. Empty means the defaults shown.
LLM_MODEL=claude-sonnet-5-5
TTS_MODEL=eleven_v4_turbo
# How long writing a turn's lines is retried before the performance fails.
CHOICES_RETRY_WINDOW=2m
# The longest a generated line may be, in characters (60 to 300). Shorter
# lines are quicker to read during a vote and make a shorter premiere.
MAX_LINE_LENGTH=160
# Optional directory of <roomId>.json scripts for the fake providers.
FAKE_SCRIPT_DIR=

# Provider keys, needed only with the real providers. Held by the worker.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
