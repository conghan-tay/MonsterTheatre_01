# Copy to .env and fill in the keys. .env is never committed.
# Every setting below except the API keys already defaults to the value shown,
# so a local run needs only the keys (and not even those until step 11).

# Server
HTTP_ADDR=:8080
LOG_LEVEL=info
# Session cookies are HTTPS-only unless this is "false". `make dev` sets it to
# false for you, because the local stack serves plain HTTP.
COOKIE_SECURE=false

# Local infrastructure (docker-compose.yml and the Temporal dev server)
DATABASE_URL=postgres://monster:monster@localhost:5432/monstertheatre?sslmode=disable
REDIS_URL=redis://localhost:6379/0
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=performance

# Provider keys (used from step 11)
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
